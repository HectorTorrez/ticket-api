{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArchitectureServicesFullAccess",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "elasticloadbalancing:*",
        "autoscaling:*",
        "application-autoscaling:*",
        "rds:*",
        "pi:*",
        "cloudfront:*",
        "acm:*",
        "route53:*",
        "cloudwatch:*",
        "logs:*",
        "cloudtrail:*",
        "cloudformation:*",
        "ecr:*",
        "ssm:*",
        "ssmmessages:*",
        "ec2messages:*",
        "kms:*",
        "iam:*",
        "sts:GetCallerIdentity",
        "sts:DecodeAuthorizationMessage",
        "tag:*",
        "resource-explorer-2:*",
        "access-analyzer:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3ListAccountBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:GetAccountPublicAccessBlock"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3TideTicketsBucketsFull",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::tidetickets-frontend-180294216289",
        "arn:aws:s3:::tidetickets-frontend-180294216289/*",
        "arn:aws:s3:::tidetickets-assets-180294216289",
        "arn:aws:s3:::tidetickets-assets-180294216289/*",
        "arn:aws:s3:::tidetickets-alb-logs-180294216289",
        "arn:aws:s3:::tidetickets-alb-logs-180294216289/*",
        "arn:aws:s3:::tidetickets-cloudtrail-180294216289",
        "arn:aws:s3:::tidetickets-cloudtrail-180294216289/*"
      ]
    }
  ]
}
